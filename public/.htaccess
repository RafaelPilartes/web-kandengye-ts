# Apache (cPanel): o site é uma SPA com rotas no cliente. Um pedido directo
# a uma rota tem de servir o index.html; ficheiros e pastas que existem
# servem-se tal como estão. Substitui o redirect do netlify.toml, que saiu.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Frame-Options "DENY"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Os ficheiros em /assets levam hash no nome: cache de um ano.
  <FilesMatch "\.(js|css|woff2?|png|svg|webp|jpg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "sw\.js$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
